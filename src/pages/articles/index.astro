---
import { env } from "cloudflare:workers";
import ArticleList from "../../components/articles/ArticleList.svelte";
import { guardModule } from "../../core/config/feature-flags";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { resolveArticleContentType } from "../../modules/articles/article-schema";

guardModule("articles");
const contentType = resolveArticleContentType(env, undefined);
---

<AdminLayout
	title="文章"
	description="搜索、浏览和管理 Firefly 内容仓库中的 Markdown 文章。"
>
	<ArticleList filenamePolicy={contentType.filenamePolicy} allowCategoryPath={contentType.allowCategoryPath} client:load />
</AdminLayout>
