{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firefly-admin",
	"compatibility_date": "2026-08-11",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/worker.ts",
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"vars": {
		"APP_VERSION": "0.1.0",
		"APP_ENV": "production",
		"SITE_ID": "firefly",
		"ACCESS_TEAM_DOMAIN": "lingering-forest-3a0a.cloudflareaccess.com",
		"ACCESS_AUDIENCE": "c3f41d062e857140ab1ba37243e7226287e304e60bce75d6096fdd6cf2b441c9",
		"ADMIN_ORIGIN": "https://blog-admin.narciranran.buzz",
		"ACCESS_ALLOWED_EMAILS": "3088491173@qq.com,1523668840@qq.com",
		"ACCESS_ALLOWED_SUBJECTS": "",
		"GITHUB_OWNER": "mei-ou",
		"GITHUB_REPO": "newfirefly",
		"GITHUB_BRANCH": "main",
		"GITHUB_CONTENT_ROOT": "src/content/posts",
		"PUBLIC_ARTICLE_URL_TEMPLATE": "",
		"PUBLIC_IMGBED_URL": "https://pic.narciranran.buzz/",
		"IMAGEBED_BASE_URL": "https://pic.narciranran.buzz",
		"IMAGEBED_UPLOAD_FOLDER": "blog",
		"FEATURE_IMAGEBED_UPLOAD": "true",
		"FEATURE_ARTICLE_LINKS": "true",
		"FEATURE_EXTERNAL_HTTPS_LINKS": "true",
		"FEATURE_SMALL_IMAGE_UPLOAD": "true",
		"FEATURE_COVER_MANAGEMENT": "true",
		"FEATURE_ARTICLE_DELETE": "true",
		"FEATURE_PDF_ATTACHMENT_UPLOAD": "false",
		"FEATURE_ARTICLE_ASSET_DETAILS": "false",
		"FEATURE_ARTICLE_ASSET_RENAME": "false"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_STAGING_BUCKET",
			"bucket_name": "firefly-admin-media-staging"
		}
	],
	"d1_databases": [
		{
			"binding": "IDEMPOTENCY_DB",
			"database_name": "firefly-admin-idempotency",
			"database_id": "ad6e7914-c61f-4a15-b6ab-9fc73c849e89",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 60,
				"period": 60
			}
		}
	]
}
